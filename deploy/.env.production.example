# Production environment for Oracle Cloud Always Free
# (Ubuntu 24.04, 2 OCPU, 12 GB RAM).
#
# Setup: cp deploy/.env.production.example .env.production
# then fill every CHANGE-ME value. The deploy script refuses to start
# until the required secrets are set. NEVER commit the filled file.
#
# --- How the Phase 2 numbers were chosen (2 OCPU / 12 GB RAM) ---
# Postgres max_connections=100 (see compose command). Consumers:
#   app pool (DB_MAX_OPEN_CONNS=20) + migration pool (short-lived, ~5) +
#   backups/psql headroom (~5) = ~30 typical, 100 hard ceiling.
# A bounded app pool queues instead of stampeding Postgres; 20 concurrent
# queries saturate 2 OCPUs long before the pool does.
# Redis: 256MB maxmemory + allkeys-lru. Cached values are tiny JSON blobs
# (tenant rows, permission string sets); 256MB holds millions. POOL_SIZE=20
# matches the app's concurrent request ceiling without idle-connection waste.
# Go runtime: GOMEMLIMIT is unnecessary here (1G container limit + GC default
# is well-behaved for this allocation profile); the 1.5-CPU app limit keeps
# noisy-neighbor bursts off Postgres' CPU share.

# Public hostname of the VM (no scheme, no trailing slash).
DOMAIN=api.example.com

# --- Secrets: generate with `openssl rand -base64 32` (JWT) / 24 (passwords) ---
# Runtime app credential (least-privilege app_user, NOBYPASSRLS).
DB_USER=app_user
DB_PASSWORD=CHANGE-ME-app-user-password
DB_NAME=tenant_saas
# Bootstrap/migration superuser. MUST differ from DB_PASSWORD.
POSTGRES_PASSWORD=CHANGE-ME-postgres-password
# Cache/ephemeral state.
REDIS_PASSWORD=CHANGE-ME-redis-password
# HS256 signing secret, minimum 32 characters (enforced at startup).
JWT_SECRET=CHANGE-ME-at-least-32-characters-long-random-secret

# --- Phase 2 pool sizing (recommended; change only with a reason) ---
DB_MAX_OPEN_CONNS=20
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=30m
DB_CONN_MAX_IDLE_TIME=10m
REDIS_POOL_SIZE=20

# --- Token lifetimes (Go duration syntax) ---
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

# --- Uploads: local persistent volume (Phase 7). Must stay in sync with
# --- nginx client_max_body_size (30m there vs 25M here + multipart overhead).
MAX_UPLOAD_BYTES=26214400

# --- Email (Resend). Blank = no-op transport; flows still mint tokens and
# --- log an undeliverable notice, so nothing breaks without a mail provider.
RESEND_API_KEY=
MAIL_FROM=
# OAuth (blank = provider login route disabled).
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URL=

# --- Browser frontends on OTHER origins only. The embedded dashboard is
# --- same-origin (no CORS needed); a separately hosted SPA lists itself here.
CORS_ALLOWED_ORIGINS=
# Apex domain for tenant-subdomain inference (acme.api.example.com).
# Leave blank unless DNS wildcard (*.DOMAIN) points at the VM.
TENANT_BASE_DOMAIN=

# --- /metrics protection. Set when Prometheus scrapes over the internet;
# --- leave blank for in-network scraping (plus optional nginx allow-list).
METRICS_TOKEN=

# --- Image selection. Defaults build on the VM; CI deploy passes
# --- APP_IMAGE=ghcr.io/<owner>/<repo>:<sha> with APP_PULL_POLICY=missing.
APP_IMAGE=tenant-saas-app:local
APP_PULL_POLICY=build
