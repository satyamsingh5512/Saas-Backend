PORT=8080
APP_ENV=development

# DATABASE_URL takes precedence over the individual DB_* settings. Use it for
# managed PostgreSQL providers, for example: postgresql://user:password@host:5432/database?sslmode=require
# DATABASE_URL=

# Runtime application credential. In production this MUST be a non-superuser
# role WITHOUT the BYPASSRLS attribute (see scripts/provision_app_role.sql and
# migrations/000009's schema comment) -- Postgres superusers bypass Row-Level
# Security entirely, which would silently disable tenant isolation.
DB_HOST=localhost
DB_PORT=5432
DB_USER=app_user
DB_PASSWORD=change-me-app-user-password
DB_NAME=tenant_saas
DB_SSLMODE=disable

# cmd/migrate (and `make db-provision-app-role`) use these MIGRATE_DB_*
# overrides instead of the DB_* values above, because applying schema
# migrations and provisioning the app_user role both require privileges
# app_user intentionally does not have. See config.ApplyMigrationOverrides.
# MIGRATE_DATABASE_URL=
MIGRATE_DB_USER=postgres
MIGRATE_DB_PASSWORD=postgres

JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRY_HOURS=24

# Refresh-token-rotation auth model (internal/identity). Go duration syntax.
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
PASSWORD_RESET_TTL=1h
EMAIL_VERIFICATION_TTL=24h

# How long a member invitation stays redeemable. Kept short because the token
# grants organization access and usually sits in an inbox.
INVITATION_TTL=168h

# Comma-separated allow-list of browser origins permitted to call the API
# cross-origin. Leave blank (the default) to disable CORS entirely, which is
# correct while the dashboard is served from the same origin as the API.
# There is deliberately no wildcard support: responses are credential-bearing.
# CORS_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com

# Connection pool sizing. The defaults suit a small managed Postgres instance.
# Raise DB_MAX_OPEN_CONNS deliberately: exceeding the server's max_connections
# turns a traffic spike into a hard outage, whereas a bounded pool queues.
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=1h
DB_CONN_MAX_IDLE_TIME=10m

# How long in-flight requests may finish after SIGTERM before the process exits.
# Keep this below your orchestrator's termination grace period.
SHUTDOWN_TIMEOUT=15s

# Outbound email via Resend. Leave RESEND_API_KEY blank to select the no-op
# transport: tokens are still minted and returned by the API, and an
# undeliverable message is logged instead of being silently dropped.
# MAIL_FROM must be on a domain verified in Resend, or every send is rejected.
# APP_BASE_URL is the public origin used to build invite/reset/verify links.
RESEND_API_KEY=
MAIL_FROM=
APP_BASE_URL=http://localhost:8080

# OAuth2 (Phase 6). Leave blank to disable a given provider's login route.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URL=

# Redis (Phase 11). Leave blank to disable caching gracefully.
REDIS_ADDR=
REDIS_PASSWORD=
REDIS_DB=0

# Kafka (Phase 10). Leave blank to disable event publishing gracefully.
KAFKA_BROKERS=

